/*End code section*/"
                input_terminals = "real I;real it;real V_feedback;real Ns_bat;real Np_bat;real modo_teste;"
                input_terminals_dimensions = "inherit;inherit;inherit;inherit;inherit;inherit"
                input_terminals_feedthrough = "True;True;True;True;True;True"
                input_terminals_show_labels = "True;True;True;True;True;True"
                output_fnc = "/*Begin code section*/
const real_t E0_1 = 16.8;
  const real_t Q_1_real = 2.3;
  const real_t R_1 = 0.01;
  const real_t K_1_real = 0.0076;
  const real_t A_1 = 0.26422;
  const real_t B_1_real = 26.5487;
  const real_t V_max_1 = 19.0;
  const real_t V_min_1 = 13.5;
  const real_t margem_religa_1 = 0.3;
  const real_t C = 2.3;
  const real_t I_max_desc = C * 2.0;
  const real_t I_max_carga = C * 0.5;

  real_t Q_1, K_1, B_1, f;
  real_t E0, Q, R, K, A, B, V_max, V_min, margem_religa;
  real_t I_max_pack_calc;
  real_t it_c, E, V_calc, SOC_calc, S_calc;

  if (modo_teste == 1.0) {
      Q_1 = 0.00055;
      f = Q_1_real / Q_1;
      K_1 = K_1_real * f;
      B_1 = B_1_real * f;
  } else {
      Q_1 = Q_1_real;
      K_1 = K_1_real;
      B_1 = B_1_real;
  }

  E0 = E0_1 * Ns_bat;
  Q  = Q_1  * Np_bat;
  R  = R_1  * Ns_bat / Np_bat;
  K  = K_1  * Ns_bat;
  A  = A_1  * Ns_bat;
  B  = B_1  / Np_bat;
  V_max = V_max_1 * Ns_bat;
  V_min = V_min_1 * Ns_bat;
  margem_religa = margem_religa_1 * Ns_bat;

  if (I < 0.0) {
      I_max_pack_calc = I_max_carga * Np_bat;
  } else {
      I_max_pack_calc = I_max_desc * Np_bat;
  }

  it_c = it;
  if (it_c < 0.0) it_c = 0.0;
  if (it_c > 0.99 * Q) it_c = 0.99 * Q;

  E = E0 - K * (Q / (Q - it_c)) * it_c + A * exp(-B * it_c);
  V_calc = E - I * R;
  SOC_calc = 100.0 * (1.0 - it / Q);
  if (SOC_calc < 0.0) SOC_calc = 0.0;
  else if (SOC_calc > 100.0) SOC_calc = 100.0;

  if (V_calc < V_min || SOC_calc <= 0.0) {
      S_calc = (V_feedback > (E + margem_religa)) ? 1.0 : 0.0;
  } else if (V_calc > V_max) {
      S_calc = 0.0;
  } else if (SOC_calc >= 100.0 && I < 0.0) {
      S_calc = 0.0;
  } else {
      S_calc = 1.0;
  }

  if (V_calc < V_min) V_calc = V_min;
  else if (V_calc > V_max) V_calc = V_max;

  V = V_calc;
  SOC = SOC_calc;
  S = S_calc;
  I_max_pack = I_max_pack_calc;
/*End code section*/"
                output_terminals = "real V;real SOC;real S;real I_max_pack;"
                output_terminals_dimensions = "inherit;inherit;inherit;inherit"
