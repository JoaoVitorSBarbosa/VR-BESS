        component "core/C function" SOC_it0_calc {
            arb_defs = "/*Begin code section*/

/*End code section*/"
            init_fnc = "/*Begin code section*/

/*End code section*/"
            input_terminals = "real SOC_inicial;real Np_bat;real modo_teste;"
            input_terminals_dimensions = "inherit;inherit;inherit"
            input_terminals_feedthrough = "True;True;True"
            input_terminals_show_labels = "True;True;True"
            output_fnc = "/*Begin code section*/
const real_t Q_1_real = 2.3;
const real_t Q_1_teste = 0.00055;
real_t Q_1, Q, it0_calc;

if (modo_teste == 1.0) {
    Q_1 = Q_1_teste;
} else {
    Q_1 = Q_1_real;
}

Q = Q_1 * Np_bat;
it0_calc = Q * (1.0 - SOC_inicial / 100.0);

it0 = it0_calc;
/*End code section*/"
            output_terminals = "real it0;"
            output_terminals_dimensions = "inherit"
            output_terminals_feedthrough = "True"
            output_terminals_show_labels = "True"
            update_fnc = "/*Begin code section*/

/*End code section*/"
        }
        [
            position = 7680, 8796
            size = 144, 120
        ]

