                output_fnc = "/*Begin code section*/
const real_t Isc_ref_1 = 3.14;
  const real_t Voc_ref_1 = 21.4;
  const real_t Kv_1 = -0.080;
  const real_t Ki_1 = 0.0024;
  const real_t Ns_1 = 36.0;
  const real_t k = 1.3806e-23;
  const real_t q = 1.6022e-19;
  const real_t a = 1.2;

  real_t Isc_ref, Voc_ref, Kv, Ki, Ns;
  real_t T_kelvin, T_ref, G_ref;
  real_t Iph, Irs, I0, expoente, Id;
  real_t V_clamped;

  /* ---- Escala pro arranjo (Ns_mod em serie, Np_mod em paralelo) ---- */
  Isc_ref = Isc_ref_1 * Np_mod;
  Voc_ref = Voc_ref_1 * Ns_mod;
  Kv = Kv_1 * Ns_mod;
  Ki = Ki_1 * Np_mod;
  Ns = Ns_1 * Ns_mod;

  T_kelvin = T + 273.15;
  T_ref = 25.0 + 273.15;
  G_ref = 1000.0;

  /* ---- Clamp de V (equivalente ao max(min(V,1.5*Voc_ref),-1)) ---- */
  V_clamped = V;
  if (V_clamped > 1.5 * Voc_ref) V_clamped = 1.5 * Voc_ref;
  if (V_clamped < -1.0) V_clamped = -1.0;

  Iph = (Isc_ref + Ki * (T_kelvin - T_ref)) * (G / G_ref);
  Irs = Isc_ref / (exp((q * Voc_ref) / (Ns * k * a * T_ref)) - 1.0);
  I0 = Irs * pow(T_kelvin / T_ref, 3.0) * exp((q * 1.12 / (a * k)) * (1.0 / T_ref - 1.0 / T_kelvin));

  expoente = (q * V_clamped) / (Ns * k * a * T_kelvin);
  if (expoente > 80.0) expoente = 80.0;

  Id = I0 * (exp(expoente) - 1.0);

  I = Iph - Id;
  if (I < 0.0) I = 0.0;
/*End code section*/"
